{
  "manifest_version": 3,
  "name": "Hide Right Tabs",
  "version": "1.1",
  "description": "Hide/show all tabs to the right of active tab via context menu",
  "permissions": ["tabs", "windows", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle hide/show right tabs"
  }
}
